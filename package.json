{
  "name": "aurora-ui",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "npm run tokens",
    "ng": "ng",
    "start": "ng serve showcase",
    "build:lib": "ng build aurora-ui",
    "build:showcase": "ng build showcase",
    "watch:lib": "ng build aurora-ui --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "ng lint aurora-ui && ng lint showcase",
    "tokens": "node scripts/build-tokens.js",
    "storybook": "ng run aurora-ui:storybook",
    "build-storybook": "ng run aurora-ui:build-storybook"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.5.2",
    "@angular-devkit/architect": "^0.2201.0",
    "@angular-devkit/build-angular": "^22.1.0",
    "@angular-devkit/core": "^22.1.0",
    "@angular/animations": "^22.1.0",
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/angular-vite": "^10.6.1",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.2",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "storybook": "^10.6.1",
    "style-dictionary": "^5.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vite": "^8.0.0"
  }
}
